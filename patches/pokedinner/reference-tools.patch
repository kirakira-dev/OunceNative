+        std::filesystem::create_directories(dump_dir);
+        std::ofstream file(fmt::format("{}/frame-{:06}.ppm", dump_dir, frame_number), std::ios::binary);
+        file << "P6\n" << layout.width << ' ' << layout.height << "\n255\n";
+        const auto pixels = buffer.Mapped();
+        for (size_t i = 0; i < pixels.size(); i += 4)
+            file.write(reinterpret_cast<const char*>(pixels.data() + i), 3);
+    }
     if (!renderer_settings.screenshot_requested) {
