+    static const char* dump_dir = std::getenv("EDEN_NX2_FRAME_DUMP");
+    static u64 frame_number{};
+    if (dump_dir && ++frame_number % 120 == 0) {
+        const auto& layout = render_window.GetFramebufferLayout();
+        const auto buffer = RenderToBuffer(framebuffers, layout, VK_FORMAT_R8G8B8A8_UNORM,
