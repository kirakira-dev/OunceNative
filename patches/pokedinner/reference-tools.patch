+    u64 dump_offset{};
+    bool watch{};
+    int filter_reg{-1};
+    u64 filter_offset{};
+    u64 filter_value{};
+};
+inline std::vector<Probe> probes;
+inline std::atomic<u64> watch_address{};
+inline std::atomic<bool> watch_done{};
+inline void Install(const std::string& name, u64 base, std::vector<u8>& image) {
+    const char* spec = std::getenv("EDEN_NX2_PROBE");
+    if (!spec) return;
+    std::string s(spec);
+    size_t at = 0;
+    while (at < s.size()) {
+        const size_t end = s.find(',', at);
+        const std::string item = s.substr(at, end == std::string::npos ? end : end - at);
+        const size_t sep = item.find(':');
+        if (sep != std::string::npos && item.substr(0, sep) == name) {
+            const u64 offset = std::strtoull(item.c_str() + sep + 1, nullptr, 16);
+            if (offset + 4 > image.size() || offset % 4) std::abort();
+            u32 word;
+            std::memcpy(&word, image.data() + offset, 4);
+            if (word != 0xd503201f && (word & 0x7fe0ffe0) != 0x2a0003e0 &&
+                (word & 0xfffffc1f) != 0xd65f0000) std::abort();
+            Probe probe{base + offset, offset, word, name, 0};
+            const size_t dump_at = item.find("@x");
+            if (dump_at != std::string::npos) {
+                char* after = nullptr;
+                probe.dump_reg = std::strtol(item.c_str() + dump_at + 2, &after, 10);
+                if (probe.dump_reg < 0 || probe.dump_reg > 30 || *after != '+') std::abort();
+                probe.dump_offset = std::strtoull(after + 1, nullptr, 16);
+                probe.watch = item.ends_with('!');
+            }
+            const size_t filter_at = item.find("?x");
+            if (filter_at != std::string::npos) {
+                char* after = nullptr;
+                probe.filter_reg = std::strtol(item.c_str() + filter_at + 2, &after, 10);
+                if (probe.filter_reg < 0 || probe.filter_reg > 30 || *after != '+') std::abort();
+                probe.filter_offset = std::strtoull(after + 1, &after, 16);
+                if (*after != '=') std::abort();
+                probe.filter_value = std::strtoull(after + 1, nullptr, 16);
+            }
+            probes.push_back(probe);
+            const u32 brk = 0xd43e0000;
+            std::memcpy(image.data() + offset, &brk, 4);
+        }
+        if (end == std::string::npos) break;
+        at = end + 1;
+    }
+}
+} // namespace Core::HvProbe
