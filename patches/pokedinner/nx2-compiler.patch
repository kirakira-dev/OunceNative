+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <array>
+#include <bit>
+#include <cstdio>
+#include <stdexcept>
+#include "shader_recompiler/frontend/ampere/lower_to_maxwell.h"
+#ifndef AMPERE_TEXTURE_HALF_STANDALONE
+#include <catch2/catch_test_macros.hpp>
+#endif
+
+namespace {
+#define PACK_CHECK(x)                     \
+    do {                                  \
+        if (!(x)) {                       \
+            throw std::runtime_error(#x); \
+        }                                 \
+    } while (false)
+using namespace Shader::Ampere;
+unsigned CheckHalfTexturePacking() {
+    unsigned tested = 0;
+    // Binary16 values with distinct lanes, signed zeros, subnormals and infinities.
+    constexpr std::array<std::array<u16, 4>, 4> samples{{
+        {0x3c00, 0x4000, 0x4200, 0x4400}, {0x0000, 0x8000, 0x3c00, 0xbc00},
+        {0x0001, 0x03ff, 0x0400, 0x7bff}, {0x7c00, 0xfc00, 0x3555, 0xb555}}};
+    for (u32 mask = 1; mask < 16; ++mask) {
+        for (bool split : {false, true}) {
+            const u32 second = split ? 20 : 255;
+            // TEX.LZ.2D.F16, texture table c0 (compute), forcing the general TEX route.
+            std::array<Instruction, 2> code{{
+                {{0x35087b60, 0x30002408, 0x049e8000U | (mask << 8) | second, 0}},
+                {{0x0000794d, 0, 0x03800000, 0}}}};
+            auto lowered = LowerToMaxwell(code, "full");
+            PACK_CHECK(lowered);
+            for (const auto& sample : samples) {
+                std::array<u32, 256> registers{};
+                std::array<u16, 4> selected{};
+                unsigned count = 0;
+                for (unsigned lane = 0; lane < 4; ++lane)
+                    if (mask & (1U << lane)) selected[count++] = sample[lane];
+                bool sampled = false;
+                for (u64 op : lowered.instructions) {
+                    const u32 dst = op & 255;
+                    if ((op >> 48) == 0x5c98) {
+                        registers[dst] = registers[(op >> 20) & 255];
+                    } else if ((op >> 60) == 0xc) {
+                        // The sampler returns ordered full-width components before narrowing.
+                        for (unsigned lane = 0; lane < count; ++lane) {
+                            const float value = static_cast<float>(std::bit_cast<_Float16>(selected[lane]));
+                            registers[dst + lane] = std::bit_cast<u32>(value);
+                        }
+                        sampled = true;
+                    } else if ((op >> 48) == 0x5ca8) {
+                        const float value = std::bit_cast<float>(registers[(op >> 20) & 255]);
+                        registers[dst] = std::bit_cast<u16>(static_cast<_Float16>(value));
+                    } else if ((op >> 48) == 0x5c18) {
+                        registers[dst] = (registers[(op >> 8) & 255] << ((op >> 39) & 31)) +
+                                         registers[(op >> 20) & 255];
+                    }
+                    registers[255] = 0;
+                }
+                PACK_CHECK(sampled);
+                const u32 first = selected[0] | (u32{selected[1]} << 16);
+                PACK_CHECK(registers[8] == first);
+                if (count > 2) {
+                    const u32 last = selected[2] | (u32{selected[3]} << 16);
+                    PACK_CHECK(registers[split ? second : 9] == last);
+                }
+                tested++;
+            }
+        }
+    }
+    return tested;
+}
+} // namespace
