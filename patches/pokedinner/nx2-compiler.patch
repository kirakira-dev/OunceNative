index 0000000..8d05118
--- /dev/null
+++ b/src/shader_recompiler/nx2_offline.cpp
@@ -0,0 +1,283 @@
+// Offline NX2 shader translation for native-host bring-up.
+// Inputs are owned shader objects and measured or reflected resource facts.
+#include <cstring>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <nlohmann/json.hpp>
+#include "common/logging.h"
+#include "shader_recompiler/environment.h"
+#include "shader_recompiler/exception.h"
+#include "shader_recompiler/host_translate_info.h"
+#include "shader_recompiler/frontend/ampere/lower_to_maxwell.h"
+#include "shader_recompiler/frontend/ampere/program_address_map.h"
+#include "shader_recompiler/frontend/maxwell/translate_program.h"
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+
+using Json = nlohmann::json;
+static std::vector<u8> Read(const std::string& path) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file) throw std::runtime_error("cannot open " + path);
+    std::vector<u8> bytes(static_cast<size_t>(file.tellg()));
+    file.seekg(0); file.read(reinterpret_cast<char*>(bytes.data()), bytes.size());
+    return bytes;
+}
+static u32 Word(const std::vector<u8>& b, size_t at) {
+    if (at + 4 > b.size()) throw std::runtime_error("truncated shader");
+    u32 v; std::memcpy(&v, b.data() + at, 4); return v;
+}
+static std::vector<u8> ReadInput(const Json& job, const char* name) {
+    const std::string hex_name = std::string{name} + "_hex";
+    if (!job.contains(hex_name)) return Read(job.at(name));
+    const auto& hex = job.at(hex_name).get_ref<const std::string&>();
+    if (hex.size() % 2) throw std::runtime_error("odd hex input length");
+    const auto digit = [](char c) -> u8 {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        throw std::runtime_error("invalid hex input");
+    };
+    std::vector<u8> bytes(hex.size() / 2);
+    for (size_t i = 0; i < bytes.size(); ++i)
+        bytes[i] = static_cast<u8>((digit(hex[2*i]) << 4) | digit(hex[2*i+1]));
+    return bytes;
+}
+
+class OfflineEnvironment final : public Shader::Environment {
+public:
+    OfflineEnvironment(const Json& j) : job(j) {
+        const auto control = ReadInput(job, "control");
+        const auto native_code = ReadInput(job, "code");
+        const u32 kind = Word(control, 0x54) >> 16;
+        constexpr Shader::Stage stages[] = {Shader::Stage::VertexB, Shader::Stage::Fragment,
+            Shader::Stage::Geometry, Shader::Stage::TessellationControl, Shader::Stage::TessellationEval,
+            Shader::Stage::Compute};
+        if (kind > 5) throw std::runtime_error("invalid shader stage");
+        stage = stages[kind];
+        if (stage == Shader::Stage::Geometry) {
+            // SDK v327680 reader slot 0x270 (0x5e7f10) reads control byte
+            // 0x58. Geometry-stage unpacking preserves it at offset 0x48.
+            // The owned shaders declare points (0) or triangles (4).
+            if (Word(control, 4) != 0xc9 || Word(control, 8) != 0xb)
+                throw std::runtime_error("unverified geometry control version");
+            const u32 input = Word(control, 0x58);
+            if (input == 0) geometry_input = Shader::InputTopology::Points;
+            else if (input == 4) geometry_input = Shader::InputTopology::Triangles;
+            else throw std::runtime_error("unsupported geometry input declaration");
+        }
+        start_address = 80;
+        is_proprietary_driver = true;
+        const size_t header = kind == 5 ? 0 : 128;
+        if (native_code.size() < header || (native_code.size() - header) % 16)
+            throw std::runtime_error("invalid code length");
+        if (kind != 5) std::memcpy(&sph, native_code.data(), sizeof(sph));
+        std::vector<Shader::Ampere::Instruction> native((native_code.size() - header) / 16);
+        std::memcpy(native.data(), native_code.data() + header, native.size() * 16);
+        std::optional<u64> fragment_outputs;
+        if (stage == Shader::Stage::Fragment) {
+            fragment_outputs = 0;
+            u32 reg = 0;
+            for (u32 target = 0; target < 8; ++target) {
+                if (!sph.ps.HasOutputComponents(target)) continue;
+                for (bool enabled : sph.ps.EnabledOutputComponents(target)) {
+                    if (enabled) *fragment_outputs |= u64{1} << reg;
+                    ++reg;
+                }
+            }
+            if (sph.ps.omap.sample_mask) *fragment_outputs |= u64{1} << reg;
+            if (sph.ps.omap.depth) *fragment_outputs |= u64{1} << (reg + 1);
+        }
+        auto lowered = Shader::Ampere::LowerToMaxwell(native, "full", fragment_outputs);
+        if (!lowered) throw std::runtime_error(fmt::format("lowering +{:#x}: {}", lowered.error_offset, lowered.error));
+        if (PreserveNativeRootTables() && lowered.reads_native_root_table && lowered.reads_native_bank17)
+            throw std::runtime_error("native root table collides with constant bank 17");
+        native_root_table = PreserveNativeRootTables() && lowered.reads_native_root_table;
+        texture_buffer = lowered.required_texture_buffer == ~0U ? 2U : lowered.required_texture_buffer;
+        quad_gradient_groups = lowered.quad_gradient_groups;
+        code.resize(10);
+        std::memcpy(code.data(), &sph, sizeof(sph));
+        for (const u64 instruction : lowered.instructions) {
+            if (code.size() % 4 == 0) code.push_back(0);
+            code.push_back(instruction);
+        }
+        code.push_back(0);
+        Shader::Ampere::AppendNativeAddressMap(code, lowered.source_instruction_offsets);
+        if (const char* directory = std::getenv("NX2_DUMP_LOWERED")) {
+            std::filesystem::create_directories(directory);
+            const auto stem = std::filesystem::path(directory) / job.at("key").get<std::string>();
+            std::ofstream binary(stem.string() + ".maxwell.bin", std::ios::binary);
+            binary.write(reinterpret_cast<const char*>(code.data()), code.size() * sizeof(u64));
+            std::ofstream(stem.string() + ".offsets.json") << Json(lowered.source_instruction_offsets);
+        }
+        if (job.contains("c1") || job.contains("c1_hex")) c1 = ReadInput(job, "c1");
+        if (kind == 5) {
+            // These quantities must be supplied until control-header fields are validated.
+            if (!job.contains("local") || !job.contains("shared") || !job.contains("local_memory"))
+                throw std::runtime_error("compute workgroup/shared/local-memory facts required");
+        }
+    }
+    u64 ReadInstruction(u32 address) override {
+        if (address % 8 || address / 8 >= code.size()) throw std::runtime_error("instruction out of bounds");
+        return code[address / 8];
+    }
+    u32 TranslateProgramAddress(u32 address) const override {
+        if (const auto translated = Shader::Ampere::NativeProgramAddress(code, address)) return *translated;
+        throw std::runtime_error("native program address has no lowering map");
+    }
+    u32 ReadCbufValue(u32 index, u32 offset) override {
+        if (index == 1 && offset + 4 <= c1.size()) return Word(c1, offset);
+        if (native_root_table && index == 17) {
+            const std::string root_key = fmt::format("0:{}", offset);
+            if (job.contains("root_constants") && job["root_constants"].contains(root_key))
+                return job["root_constants"][root_key];
+            throw std::runtime_error("root constant fact required " + root_key);
+        }
+        const std::string key = fmt::format("{}:{}", index, offset);
+        if (job.contains("cbuf") && job["cbuf"].contains(key)) return job["cbuf"][key];
+        throw std::runtime_error("constant-buffer fact required " + key);
+    }
+    Shader::TextureType ReadTextureType(u32 handle) override {
+        return static_cast<Shader::TextureType>(TextureFact(handle, "type"));
+    }
+    Shader::TexturePixelFormat ReadTexturePixelFormat(u32 handle) override {
+        return static_cast<Shader::TexturePixelFormat>(TextureFact(handle, "format"));
+    }
+    bool IsTexturePixelFormatInteger(u32 handle) override { return TextureFact(handle, "integer") != 0; }
+    u32 TextureFact(u32 handle, const char* name) {
+        const auto key = std::to_string(handle);
+        if (job.contains("textures") && job["textures"].contains(key) && job["textures"][key].contains(name))
+            return job["textures"][key][name];
+        throw std::runtime_error(fmt::format("texture fact required {}:{}", handle, name));
+    }
+    u32 ReadViewportTransformState() override { return 1; }
+    u32 TextureBoundBuffer() const override { return texture_buffer; }
+    bool PreserveNativeRootTables() const override { return job.value("native_root_tables", false); }
+    u32 LocalMemorySize() const override { return stage == Shader::Stage::Compute ? job.at("local_memory").get<u32>() : static_cast<u32>(sph.LocalMemorySize()) + sph.common3.shader_local_memory_crs_size; }
+    u32 SharedMemorySize() const override { return job.value("shared", 0U); }
+    std::array<u32, 3> WorkgroupSize() const override { return job.value("local", std::array<u32,3>{1,1,1}); }
+    bool HasHLEMacroState() const override { return stage == Shader::Stage::VertexB; }
+    std::optional<Shader::ReplaceConstant> GetReplaceConstBuffer(u32 bank, u32 offset) override {
+        // NVN's instanced-draw macro mirrors its base instance into c[0][0x644].
+        if (stage == Shader::Stage::VertexB && bank == 0 && offset == 0x644)
+            return Shader::ReplaceConstant::BaseInstance;
+        return std::nullopt;
+    }
+    void Dump(u64, u64) override {}
+    const Json& job;
+    std::vector<u64> code;
+    std::vector<u8> c1;
+    u32 texture_buffer{};
+    u32 quad_gradient_groups{};
+    bool native_root_table{};
+    Shader::InputTopology geometry_input{Shader::InputTopology::Triangles};
+};
+
+static Json Describe(const Shader::Info& info) {
+    Json out = {{"cbufs", Json::array()}, {"sbufs", Json::array()}, {"textures", Json::array()}, {"images", Json::array()}};
+    u32 binding{};
+    for (const auto& d : info.constant_buffer_descriptors)
+        out["cbufs"].push_back({{"binding", binding++}, {"slot",d.index}, {"count",d.count}});
+    for (const auto& d : info.storage_buffers_descriptors)
+        out["sbufs"].push_back({{"binding", binding++}, {"cb_slot",d.cbuf_index}, {"cb_offset",d.cbuf_offset}, {"count",d.count}, {"written",d.is_written}});
+    for (const auto& d : info.texture_buffer_descriptors)
+        out["textures"].push_back({{"binding", binding++}, {"type",7}, {"cb_slot",d.cbuf_index}, {"cb_offset",d.cbuf_offset}, {"count",d.count}});
+    for (const auto& d : info.image_buffer_descriptors)
+        out["images"].push_back({{"binding", binding++}, {"type",7}, {"cb_slot",d.cbuf_index}, {"cb_offset",d.cbuf_offset}, {"count",d.count}});
+    for (const auto& d : info.texture_descriptors)
+        out["textures"].push_back({{"binding", binding++}, {"type",static_cast<u32>(d.type)}, {"cb_slot",d.cbuf_index}, {"cb_offset",d.cbuf_offset}, {"count",d.count}, {"integer",d.is_integer}, {"depth",d.is_depth}, {"multisample",d.is_multisample}, {"secondary",d.has_secondary}, {"secondary_cb_slot",d.secondary_cbuf_index}, {"secondary_cb_offset",d.secondary_cbuf_offset}});
+    for (const auto& d : info.image_descriptors)
+        out["images"].push_back({{"binding", binding++}, {"type",static_cast<u32>(d.type)}, {"cb_slot",d.cbuf_index}, {"cb_offset",d.cbuf_offset}, {"count",d.count}, {"format",static_cast<u32>(d.format)}});
+    return out;
+}
+
+int main(int argc, char** argv) {
+    if (argc != 3) return 2;
+    Common::Log::Initialize();
+    Common::Log::SetGlobalFilter(Common::Log::Filter{Common::Log::Level::Error});
+    Common::Log::Start();
+    const auto jobs = Json::parse(std::ifstream{argv[1]});
+    std::filesystem::create_directories(argv[2]);
+    unsigned ok{}, bad{};
+    std::ofstream report(std::filesystem::path(argv[2]) / "compile-report.jsonl");
+    for (const auto& job : jobs) {
+        const std::string key = job.at("key");
+        try {
+            OfflineEnvironment env(job);
+            Shader::ObjectPool<Shader::IR::Inst> instructions;
+            Shader::ObjectPool<Shader::IR::Block> blocks;
+            Shader::ObjectPool<Shader::Maxwell::Flow::Block> flow;
+            Shader::Maxwell::Flow::CFG cfg{env, flow, env.StartAddress()};
+            Shader::HostTranslateInfo host{};
+            host.support_float16 = true; host.support_int64 = true;
+            host.support_snorm_render_buffer = true;
+            host.support_conditional_barrier = true;
+            host.support_viewport_index_layer = true;
+            host.ApplyDescriptorLimitPolicy();
+            auto program = Shader::Maxwell::TranslateProgram(instructions, blocks, env, cfg, host);
+            Shader::Profile profile{};
+            profile.supported_spirv = 0x00010500;
+            profile.unified_descriptor_binding = true;
+            profile.support_int64 = true;
+            profile.support_int16 = true;
+            profile.support_vote = true;
+            profile.support_quad_shuffles = true;
+            profile.support_shuffle_relative = true;
+            profile.support_typeless_image_loads = true;
+            profile.support_derivative_control = true;
+            profile.support_viewport_index_layer_non_geometry = true;
+            profile.support_geometry_streams = true;
+            profile.need_fastmath_off = true;
+            profile.max_user_clip_distances = 8;
+            profile.max_subgroup_size = 32;
+            Shader::RuntimeInfo runtime{};
+            runtime.input_topology = env.geometry_input;
+            runtime.previous_stage_stores.mask.set();
+            if (env.ShaderStage() == Shader::Stage::TessellationControl ||
+                env.ShaderStage() == Shader::Stage::TessellationEval) {
+                const auto& tess = job.at("tessellation");
+                const std::string domain = tess.at("domain");
+                const std::string spacing = tess.at("spacing");
+                if (domain == "triangles") runtime.tess_primitive = Shader::TessPrimitive::Triangles;
+                else if (domain == "quads") runtime.tess_primitive = Shader::TessPrimitive::Quads;
+                else if (domain == "isolines") runtime.tess_primitive = Shader::TessPrimitive::Isolines;
+                else throw std::runtime_error("invalid tessellation domain");
+                if (spacing == "equal") runtime.tess_spacing = Shader::TessSpacing::Equal;
+                else if (spacing == "fractional_odd") runtime.tess_spacing = Shader::TessSpacing::FractionalOdd;
+                else if (spacing == "fractional_even") runtime.tess_spacing = Shader::TessSpacing::FractionalEven;
+                else throw std::runtime_error("invalid tessellation spacing");
+                if (tess.at("point_mode").get<bool>())
+                    throw std::runtime_error("tessellation point mode is not implemented");
+                runtime.tess_clockwise = tess.at("clockwise").get<bool>();
+                if (env.ShaderStage() == Shader::Stage::TessellationControl)
+                    runtime.tess_control_primitive = runtime.tess_primitive;
+            }
+            Shader::Backend::Bindings bindings;
+            auto spirv = Shader::Backend::SPIRV::EmitSPIRV(profile, runtime, program, bindings);
+            const auto stem = std::filesystem::path(argv[2]) / key;
+            std::ofstream file(stem.string() + ".spv", std::ios::binary);
+            file.write(reinterpret_cast<const char*>(spirv.data()), spirv.size() * 4);
+            auto description = Describe(program.info);
+            if (env.quad_gradient_groups)
+                description["native_quad_gradient_groups"] = env.quad_gradient_groups;
+            if (env.ShaderStage() == Shader::Stage::Geometry) {
+                description["geometry"] = {
+                    {"input", env.geometry_input == Shader::InputTopology::Points ? "points" : "triangles"},
+                    {"input_vertices", Shader::InputTopologyVertices::vertices(env.geometry_input)},
+                    {"output_vertices", program.output_vertices},
+                    {"invocations", program.invocations},
+                };
+            }
+            if (job.contains("tessellation")) description["tessellation"] = job.at("tessellation");
+            if (env.native_root_table) description["native_root_table"] = {{"lowered_bank",17}, {"index",0}};
+            std::ofstream(stem.string() + ".json") << description.dump(2);
+            ++ok;
+            report << Json{{"key",key},{"status","ok"}}.dump() << '\n';
+        } catch (const std::exception& e) {
+            ++bad; std::cerr << key << ": " << e.what() << '\n';
+            report << Json{{"key",key},{"status","error"},{"error",e.what()}}.dump() << '\n';
+        }
+        report.flush();
+    }
+    std::cout << ok << " translated, " << bad << " rejected\n";
+    Common::Log::Stop();
+    return bad ? 1 : 0;
+}
