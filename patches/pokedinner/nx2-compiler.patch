+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <array>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "shader_recompiler/frontend/ampere/lower_to_maxwell.h"
+
+namespace {
+using namespace Shader::Ampere;
+
+std::vector<Instruction> fixture() {
+    std::vector<Instruction> code;
+    const auto push = [&](u32 a, u32 b, u32 c) { code.push_back({{a,b,c,0}}); };
+    for (u32 lane=0;lane<4;++lane) {
+        push(0x1a0f7f55,0,0);push(0x1a0f7f56,0,0x100000);
+        for (u32 i=0;i<9;++i)
+            push((lane?0x7f89:0x7589)|((40+i)<<16)|((30+i)<<24),
+                 lane?0x1c0300|(lane<<21):0x1c03ff,0xe0000);
+        for (u32 axis=0;axis<3;++axis)
+            push(0x7822|((40+axis)<<16)|((43+axis)<<24),lane%2?0xbb:0xcc,0x2000|40+axis);
+        for (u32 axis=0;axis<3;++axis)
+            push(0x7822|((16+axis)<<16)|((46+axis)<<24),lane<2?0xf0:0xaf,0x2000|40+axis);
+        push(0x10107b60,0x50800a12,0x1e21ff);
+        push(0x791a,0x8020,0);push(0x1a0f7f56,0,0);
+        push(0x87202,16,0x100<<lane);
+    }
+    push(0x7202,8,0xf00);
+    push(0x794d,0,0x3800000);
+    return code;
+}
+
+TEST_CASE("Ampere quad gradient recovery preserves inputs and rejects unsafe groups", "[video_core][ampere]") {
+    auto code=fixture();
+    auto translated=LowerToMaxwell(code,"full",1);
+    INFO(translated.error);
+    REQUIRE((static_cast<bool>(translated)));
+    REQUIRE((translated.quad_gradient_groups==1));
+    std::array<u32,256> regs{};for(u32 i=0;i<256;++i)regs[i]=i;
+    bool sampled=false;
+    for(auto op:translated.instructions){
+        if(op>>48==0x5c98)regs[op&255]=regs[(op>>20)&255];
+        else if(op>>56==0xde){
+            REQUIRE(((op&255)==8&&((op>>28)&7)==4&&((op>>31)&15)==1&&((op>>36)&0x1fff)==10));
+            for(u32 a=0;a<3;++a){REQUIRE((regs[246+a]==30+a));REQUIRE((regs[249+a*2]==33+a));REQUIRE((regs[250+a*2]==36+a));}
+            sampled=true;
+        }
+    }
+    REQUIRE((sampled));
+    unsigned rejected=0;
+    const auto reject=[&](std::vector<Instruction> changed,std::optional<u64> outputs=1){
+        auto result=LowerToMaxwell(changed,"full",outputs);
+        REQUIRE_FALSE(static_cast<bool>(result));
+        ++rejected;
+    };
+    reject(code,{});reject(code,u64{1}<<17);
+    for(u32 lane=0;lane<4;++lane){
+        const u32 start=lane*21;
+        for(u32 offset:{0U,1U,18U,19U}){auto c=code;c[start+offset].words[2]^=1;reject(c);}
+        for(u32 offset:{2U,11U,14U,17U,20U}){auto c=code;c[start+offset].words[0]^=0x1000;reject(c);}
+        {auto c=code;c[start+2].words[1]^=1<<21;reject(c);}
+        {auto c=code;c[start+11].words[1]^=1;reject(c);}
+        {auto c=code;c[start+14].words[1]^=1;reject(c);}
+        {auto c=code;c[start+17].words[1]^=1<<22;reject(c);}
+        {auto c=code;c[start+20].words[2]^=0x100;reject(c);}
+    }
+    {auto c=code;c[84].words[1]=17;reject(c);}
+    {auto c=code;c[84]={{0x001170202,30,0xf00,0}};reject(c,u64{1}<<17);}
+    {auto c=code;c.insert(c.begin()+83,Instruction{{0x977202,8,0xf00,0}});reject(c);}
+    {auto c=code;c.insert(c.begin(),Instruction{{0x7947,0x20,0x3800000,0}});reject(c);}
+    {auto c=code;c[84]={{0x7944,0,0x3800000,0}};reject(c);}
+    {auto c=code;c[84]={{0xdead,0,0,0}};reject(c);}
+    {auto c=code;c.insert(c.begin()+83,Instruction{{0x107802,0,0xf00,0}});reject(c);}
+    {auto c=code;c.insert(c.begin()+83,Instruction{{0x117802,0,0xf00,0}});REQUIRE((static_cast<bool>(LowerToMaxwell(c,"full",1))));}
+    {auto c=code;c[84]={{0x0f7941,0,0x3800000,0}};reject(c);}
+    for(unsigned i=0;i<84;++i){auto c=code;c[i].words[3]^=1;reject(c);}
+    // A predicated definition cannot prove a temporary dead on its false path.
+    {auto c=code;c.insert(c.begin()+84,Instruction{{0x00170202,30,0xf00,0}});c[85].words[1]=17;reject(c);}
+    // Both successors of a conditional branch participate in the liveness proof.
+    {auto c=code;c.insert(c.begin()+84,Instruction{{0x00000947,16,0x3800000,0}});c.insert(c.begin()+85,Instruction{{0x00177802,0,0xf00,0}});c[86].words[1]=17;reject(c);}
+    REQUIRE((rejected == 152));
+}
+} // namespace
