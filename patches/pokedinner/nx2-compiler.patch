diff --git a/src/shader_recompiler/frontend/ampere/instruction.h b/src/shader_recompiler/frontend/ampere/instruction.h
new file mode 100644
index 0000000..8f0942e
--- /dev/null
+++ b/src/shader_recompiler/frontend/ampere/instruction.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include "common/common_types.h"
+
+namespace Shader::Ampere {
+
+struct Instruction {
+    std::array<u32, 4> words;
+
+    u32 Bits(u32 offset, u32 count) const {
+        u64 bits = words[offset / 32];
+        if (offset / 32 + 1 < words.size()) {
+            bits |= u64{words[offset / 32 + 1]} << 32;
+        }
+        return static_cast<u32>((bits >> (offset % 32)) & ((u64{1} << count) - 1));
+    }
+};
+static_assert(sizeof(Instruction) == 16);
+
+} // namespace Shader::Ampere
diff --git a/src/shader_recompiler/frontend/ampere/quad_gradient.h b/src/shader_recompiler/frontend/ampere/quad_gradient.h
new file mode 100644
index 0000000..0ac41e2
--- /dev/null
+++ b/src/shader_recompiler/frontend/ampere/quad_gradient.h
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <bitset>
+#include <deque>
+#include <optional>
+#include <span>
+#include <string_view>
+#include <vector>
+#include "shader_recompiler/frontend/ampere/instruction.h"
+
+namespace Shader::Ampere {
+
+struct QuadGradient {
+    u32 begin{}, end{}, result_move{}, output{}, texture{};
+    std::array<std::array<u32, 3>, 3> inputs{}; // coordinate, dx, dy for each axis
+    std::bitset<256> discarded;
+};
+
+struct QuadGradients {
+    std::vector<QuadGradient> groups;
+    std::vector<bool> suppressed;
+    u32 error_offset{};
+    std::string_view error;
+};
+
+struct QuadRegisterAccess {
+    std::bitset<256> read, write, killed;
+    bool known = true;
+};
+
+// This analysis deliberately recognizes fewer operations than the lowerer.
+// An unknown instruction cannot establish that a discarded temporary is dead.
+inline QuadRegisterAccess QuadAccess(const Instruction& insn, u64 fragment_outputs) {
+    QuadRegisterAccess out;
+    const u32 op = insn.Bits(0, 12), d = insn.Bits(16, 8), a = insn.Bits(24, 8);
+    const u32 b = insn.Bits(32, 8), c = insn.Bits(64, 8), pred = insn.Bits(12, 4);
+    if (pred == 15) return out;
+    const auto read = [&](std::initializer_list<u32> regs) {
+        for (u32 reg : regs) if (reg != 255) out.read.set(reg);
+    };
+    const auto write = [&] {
+        if (d != 255) out.write.set(d);
+    };
+    const auto possible_vector = [](std::bitset<256>& mask, u32 reg) {
+        if (reg != 255) for (u32 i = reg; i < reg + 4 && i < 255; ++i) mask.set(i);
+    };
+    bool exact_write = true;
+    switch (op) {
+    case 0x220: case 0x221: case 0x208: case 0x230: case 0x232:
+        read({a, b}); write(); break;
+    case 0x20b:
+        read({a, b}); break;
+    case 0x223:
+        read({a, b, c}); write(); break;
+    case 0x820: case 0xa20: case 0x821: case 0xa21: case 0x840:
+        read({a}); write(); break;
+    case 0x80b: case 0xa0b:
+        read({a}); break;
+    case 0x423: case 0x623: case 0x823: case 0xa23: case 0x431: case 0x631:
+    case 0x421: case 0x621: case 0x430: case 0x816: case 0x812:
+        read({a, c}); write(); break;
+    case 0x308: case 0x306: case 0x307: case 0x304: case 0x202:
+        read({b}); write();
+        if (op == 0x202 && insn.Bits(72, 4) != 15) exact_write = false;
+        break;
+    case 0x802: case 0xa02: case 0x805:
+        write(); break;
+    case 0x23e:
+        read({b, insn.Bits(78, 1) ? c : a}); write(); break;
+    case 0xb66:
+        possible_vector(out.read, a); possible_vector(out.read, b);
+        possible_vector(out.write, d); possible_vector(out.write, c);
+        exact_write = false;
+        break;
+    case 0x983:
+        read({a}); possible_vector(out.write, d); exact_write = false; break;
+    case 0x94d:
+        for (u32 reg = 0; reg < 64; ++reg) if (fragment_outputs & (u64{1} << reg)) out.read.set(reg);
+        break;
+    case 0x941: case 0x942: case 0x945: case 0x947: case 0x918: case 0x91a:
+        break;
+    default:
+        out.known = false;
+        break;
+    }
+    if (pred == 7 && exact_write) out.killed = out.write;
+    return out;
+}
+
+inline QuadGradients FindQuadGradients(std::span<const Instruction> code,
+                                      std::optional<u64> fragment_outputs,
+                                      const std::vector<bool>& branch_entries) {
+    QuadGradients result;
+    bool present = false;
+    for (const auto& insn : code) present |= insn.Bits(0, 12) == 0xf55;
+    if (!present) return result;
+    const auto fail = [&](u32 pc, std::string_view error) {
+        result.error_offset = pc * 16;
+        result.error = error;
+        return result;
+    };
+    if (!fragment_outputs) return fail(0, "native quad gradients require fragment output facts");
+    // Calls and computed branches need a separate interprocedural liveness proof.
+    for (u32 pc = 0; pc < code.size(); ++pc) {
+        const u32 op = code[pc].Bits(0, 12);
+        if (op == 0x944 || op == 0x949 || op == 0x950 || op == 0x958)
+            return fail(pc, "native quad gradient control flow is not supported");
+        if ((op == 0x945 || op == 0x941 || op == 0x942) && code[pc].Bits(16, 8) == 15)
+            return fail(pc, "native quad gradient mask token escapes the group");
+    }
+    result.suppressed.resize(code.size());
+    const auto exact = [&](u32 pc, u32 a, u32 b, u32 c) {
+        return pc < code.size() && code[pc].words[0] == a &&
+               code[pc].words[1] == b && code[pc].words[2] == c && !(code[pc].words[3] & 0x1ff);
+    };
+    for (u32 pc = 0; pc < code.size(); ++pc) {
+        if (code[pc].Bits(0, 12) != 0xf55 || result.suppressed[pc]) continue;
+        QuadGradient group;
+        group.begin = pc;
+        u32 cursor = pc;
+        std::bitset<256> preceding;
+        for (u32 lane = 0; lane < 4; ++lane) {
+            if (!exact(cursor, 0x1a0f7f55, 0, 0) ||
+                !exact(cursor + 1, 0x1a0f7f56, 0, 0x100000))
+                return fail(cursor, "native quad gradient mask save/activation");
+            result.suppressed[cursor++] = true;
+            result.suppressed[cursor++] = true;
+            struct Value {
+                u32 kind{}, coord{}, dx{}, dy{};
+            };
+            std::array<Value, 256> regs{};
+            for (u32 reg = 0; reg < 256; ++reg) regs[reg].coord = reg;
+            u32 shuffles{}, adds{};
+            for (; cursor < code.size() && code[cursor].Bits(0, 12) != 0xb60; ++cursor) {
+                const auto& insn = code[cursor];
+                const u32 op = insn.Bits(0, 12), d = insn.Bits(16, 8), a = insn.Bits(24, 8);
+                const u32 b = insn.Bits(64, 8);
+                if (insn.Bits(12, 4) != 7 || d >= 216 || a >= 216 || adds + shuffles >= 15 ||
+                    (insn.words[3] & 0x1ff))
+                    return fail(cursor, "native quad gradient operand/predicate");
+                if (op == (lane == 0 ? 0x589U : 0xf89U)) {
+                    const u32 mask = lane == 0 ? 0x1c03ff : 0x1c0300 | (lane << 21);
+                    if (insn.words[1] != mask || insn.words[2] != 0xe0000 ||
+                        regs[a].kind != 0 || preceding[a])
+                        return fail(cursor, "native quad gradient broadcast source");
+                    regs[d] = {1, regs[a].coord, 0, 0};
+                    ++shuffles;
+                } else if (op == 0x822) {
+                    if (b >= 216 || insn.words[2] != (0x2000 | b) || regs[a].kind != 1)
+                        return fail(cursor, "native quad gradient swizzled add mode");
+                    const auto left = regs[a], right = regs[b];
+                    if (insn.words[1] == (lane % 2 == 0 ? 0xccU : 0xbbU) && right.kind == 1)
+                        regs[d] = {2, right.coord, left.coord, 0};
+                    else if (insn.words[1] == (lane < 2 ? 0xf0U : 0xafU) && right.kind == 2)
+                        regs[d] = {3, right.coord, right.dx, left.coord};
+                    else
+                        return fail(cursor, "native quad gradient coordinate expression");
+                    ++adds;
+                } else {
+                    return fail(cursor, "native quad gradient has an unrecognized operation");
+                }
+                group.discarded.set(d);
+                result.suppressed[cursor] = true;
+            }
+            if (cursor >= code.size() || shuffles != 9 || adds != 6)
+                return fail(cursor, "native quad gradient is incomplete");
+            const auto& sample = code[cursor];
+            if (sample.words[0] != 0x10107b60 || sample.words[2] != 0x001e21ff ||
+                (sample.words[1] & 0xffe00000U) != 0x50800000U || sample.Bits(40, 14) > 0x1fff ||
+                (sample.words[3] & 0x1ff))
+                return fail(cursor, "native quad gradient sample mode");
+            const u32 texture = sample.Bits(40, 14);
+            const std::array<u32, 3> coords{16, 17, sample.Bits(32, 8)};
+            for (u32 axis = 0; axis < 3; ++axis) {
+                const auto& value = regs[coords[axis]];
+                const std::array<u32, 3> inputs{value.coord, value.dx, value.dy};
+                if (value.kind != 3 || (lane && inputs != group.inputs[axis]))
+                    return fail(cursor, "native quad gradient lane inputs disagree");
+                group.inputs[axis] = inputs;
+            }
+            if (lane && texture != group.texture)
+                return fail(cursor, "native quad gradient lane textures disagree");
+            group.texture = texture;
+            group.discarded.set(16);
+            result.suppressed[cursor++] = true;
+            if (!exact(cursor, 0x791a, 0x8020, 0) || !exact(cursor + 1, 0x1a0f7f56, 0, 0))
+                return fail(cursor, "native quad gradient wait/restore");
+            result.suppressed[cursor++] = true;
+            result.suppressed[cursor++] = true;
+            group.end = cursor;
+            bool saved = false;
+            for (u32 gap = 0; cursor < code.size() && gap < 9; ++gap, ++cursor) {
+                const auto& move = code[cursor];
+                if ((move.words[0] & 0xff00ffffU) == 0x7202 && move.words[1] == 16 &&
+                    move.words[2] == (0x100U << lane) && !(move.words[3] & 0x1ff)) {
+                    const u32 output = move.Bits(16, 8);
+                    if (output >= 216 || (lane && output != group.output))
+                        return fail(cursor, "native quad gradient result lanes disagree");
+                    group.output = output;
+                    group.result_move = cursor;
+                    result.suppressed[cursor++] = true;
+                    preceding |= group.discarded;
+                    preceding.set(output);
+                    saved = true;
+                    break;
+                }
+                if (lane != 3) break;
+            }
+            if (!saved) return fail(cursor, "native quad gradient masked result is missing");
+        }
+        for (const auto& axis : group.inputs)
+            for (u32 reg : axis)
+                if (reg == group.output) return fail(pc, "native quad gradient input aliases result");
+        for (u32 i = group.begin + 1; i <= group.result_move; ++i) {
+            if (branch_entries[i]) return fail(i, "native branch enters a quad gradient group");
+            if (i < group.end || i == group.result_move) continue;
+            const auto access = QuadAccess(code[i], *fragment_outputs);
+            if (!access.known || access.read[group.output] || access.write[group.output] || access.write[16])
+                return fail(i, "native quad gradient delayed result has an observable dependency");
+        }
+        group.discarded.reset(group.output);
+        result.groups.push_back(group);
+        pc = group.result_move;
+    }
+
+    std::vector<const QuadGradient*> start(code.size());
+    for (const auto& group : result.groups) start[group.begin] = &group;
+    std::vector<std::bitset<256>> states(code.size());
+    std::vector<bool> visited(code.size());
+    std::deque<u32> pending{0};
+    visited[0] = true;
+    while (!pending.empty()) {
+        const u32 pc = pending.front();
+        pending.pop_front();
+        auto dirty = states[pc];
+        const auto& insn = code[pc];
+        const u32 op = insn.Bits(0, 12);
+        std::array<u32, 2> successors{pc + 1, static_cast<u32>(code.size())};
+        if (const auto* group = start[pc]) {
+            for (const auto& axis : group->inputs)
+                for (u32 reg : axis)
+                    if (dirty[reg]) return fail(pc, "native quad gradient reads a discarded temporary");
+            dirty |= group->discarded;
+            dirty.reset(group->output);
+            successors[0] = group->end;
+        } else if (!result.suppressed[pc]) {
+            const auto access = QuadAccess(insn, *fragment_outputs);
+            if (dirty.any() && (!access.known || (dirty & access.read).any()))
+                return fail(pc, "native quad gradient temporary remains live");
+            dirty &= ~access.killed;
+            if (op == 0x947) {
+                const u64 raw = (insn.words[1] & ~1U) | (u64{insn.words[2] & 0x3ffff} << 32);
+                const s64 target = s64{pc} * 16 + 16 + (static_cast<s64>(raw << 14) >> 14);
+                if (target < 0 || target % 16 || static_cast<u64>(target / 16) >= code.size())
+                    return fail(pc, "native quad gradient branch leaves program");
+                successors[1] = static_cast<u32>(target / 16);
+                if (insn.Bits(12, 4) == 7 && insn.Bits(87, 4) == 7) successors[0] = successors[1];
+            }
+            if (op == 0x94d && insn.Bits(12, 4) == 7 && insn.Bits(87, 4) == 7)
+                successors.fill(static_cast<u32>(code.size()));
+        }
+        for (u32 next : successors) {
+            if (next >= code.size()) continue;
+            if (!visited[next] || (dirty & ~states[next]).any()) {
+                visited[next] = true;
+                states[next] |= dirty;
+                pending.push_back(next);
+            }
+        }
+    }
+    return result;
+}
+
+} // namespace Shader::Ampere
